module {
  tt.func public @kernel(%arg0: !tt.ptr<f32> {tt.divisibility = 16 : i32}, %arg1: !tt.ptr<f32> {tt.divisibility = 16 : i32}, %arg2: !tt.ptr<f32> {tt.divisibility = 16 : i32}) attributes {noinline = false} 
    %c1_i32 = arith.constant 1 : i32
    %c2_i32 = arith.constant 2 : i32
    %c0_i32 = arith.constant 0 : i32
    %cst = arith.constant dense<4> : tensor<4xi32>
    %BLOCK_SIZE = tt.make_range {end = 4 : i32, start = 0 : i32} : tensor<4xi32>

    // start_idx = arg3
    // end_idx = c2_i32
    // step = c1_i32
    %range = scf.for %arg3 = %c0_i32 to %c2_i32 step %c1_i32 iter_args(%arg4 = %BLOCK_SIZE) -> (tensor<4xi32>)  : i32 {

      // load a
      %offsets = tt.splat %arg0 : !tt.ptr<f32> -> tensor<4x!tt.ptr<f32>>
      %offsets_0 = tt.addptr %offsets, %arg4 : tensor<4x!tt.ptr<f32>>, tensor<4xi32>
      %a_temp1 = tt.load %offsets_0 : tensor<4x!tt.ptr<f32>>

      // load b
      %offsets_1 = tt.splat %arg1 : !tt.ptr<f32> -> tensor<4x!tt.ptr<f32>>
      %offsets_2 = tt.addptr %offsets_1, %arg4 : tensor<4x!tt.ptr<f32>>, tensor<4xi32>
      %b_temp1 = tt.load %offsets_2 : tensor<4x!tt.ptr<f32>>

      // a * b
      %b = arith.mulf %a_temp1, %b_temp1 : tensor<4xf32>

      // store
      %offsets_3 = tt.splat %arg2 : !tt.ptr<f32> -> tensor<4x!tt.ptr<f32>>
      %offsets_4 = tt.addptr %offsets_3, %arg4 : tensor<4x!tt.ptr<f32>>, tensor<4xi32>
      tt.store %offsets_4, %b : tensor<4x!tt.ptr<f32>>

      // advance offsets
      %offsets_5 = arith.addi %arg4, %cst : tensor<4xi32>

      scf.yield %offsets_5 : tensor<4xi32>
    }
    tt.return
  
}

